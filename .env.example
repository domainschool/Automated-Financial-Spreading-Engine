# SpreadSense AI - Environment Variables
# SEC EDGAR requires a custom User-Agent in fair-access format: Sample Company Name AdminContact@domain.com
VITE_SEC_USER_AGENT=SpreadSenseAI UnderwritingEngine admin@spreadsense.internal

# Optional: Google Gemini / OpenAI API Key for AI Taxonomy Classification
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
